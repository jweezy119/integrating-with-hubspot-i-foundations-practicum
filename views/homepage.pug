doctype html
html 
    head 
        title= title
        link(rel="stylesheet", href="/css/style.css")
    body    
        h1 Custom Object: Pets
        a(href="/update-cobj") Add to this table
        table
            tr
                th Name
                th Type
                th Favorite Toy
            each pet in data
                tr
                    td #{pet.properties.name}
                    td #{pet.properties.pet_type}
                    td #{pet.properties.favorite_toy}